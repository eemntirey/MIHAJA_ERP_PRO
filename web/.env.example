# =============================================================================
# MIHAJA_ERP_PRO — Docker Compose / local environment
# Copy to .env and adjust. Never commit .env
# =============================================================================

# --- PostgreSQL ---
POSTGRES_DB=erp_db
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erp_password
POSTGRES_HOST_PORT=127.0.0.1:5432

# From host (Alembic, local flask):
DATABASE_URL=postgresql+psycopg://erp_user:erp_password@127.0.0.1:5432/erp_db

# From inside Docker network (backend service default in compose):
# DATABASE_URL=postgresql+psycopg://erp_user:erp_password@postgres:5432/erp_db

# Empty DB for baseline generation (create manually after postgres is up):
# CREATE DATABASE erp_empty;
# DATABASE_URL=postgresql+psycopg://erp_user:erp_password@127.0.0.1:5432/erp_empty

# --- Redis ---
REDIS_PASSWORD=redispassword
REDIS_HOST_PORT=127.0.0.1:6379
REDIS_URL=redis://:redispassword@127.0.0.1:6379/0

# --- Flask ---
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=jwt-secret-key-change-in-production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Ports ---
BACKEND_HOST_PORT=5000
FRONTEND_HOST_PORT=3000
REACT_APP_API_URL=http://localhost:5000/api/v1

# --- SQLAlchemy pool (backend) ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# --- PostgreSQL tuning (docker postgres service) ---
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_MAX_CONNECTIONS=100
# Log queries slower than N ms (0 = all, -1 = off)
PG_LOG_MIN_DURATION=500
