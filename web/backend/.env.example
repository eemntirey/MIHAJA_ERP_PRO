FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=jwt-secret-key-change-in-production
DATABASE_URL=sqlite:///erp.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=redispassword
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SERPAPI_KEY=
ENCRYPTION_KEY=

# ============================================================
# SMTP / Envoi d'e-mails (password reset, welcome, notifications)
# Utilise par app/services/email_service.py.
# Si MAIL_HOST n'est pas defini, les e-mails ne sont pas envoyes
# mais aucune erreur n'est levee (mode dev).
# ============================================================
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@mihaja-erp.local
MAIL_FROM_NAME=MIHAJA ERP
MAIL_USE_TLS=true
MAIL_TIMEOUT=15

# URL publique de l'application (utilisee dans les liens des e-mails)
APP_URL=http://localhost:3000

# Duree de validite du token de reinitialisation de mot de passe (minutes)
PASSWORD_RESET_TTL_MINUTES=30
UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH=16777216

# Papi Payment Gateway
PAPI_API_URL=https://app.papi.mg/dashboard/api/payment-links
PAPI_API_KEY=
PAPI_ENVIRONMENT=sandbox
PAPI_WEBHOOK_SECRET=
PAPI_CALLBACK_URL=http://localhost:5000/api/v1/papi/webhook
