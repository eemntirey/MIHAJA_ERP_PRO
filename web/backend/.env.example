FLASK_ENV=development
SECRET_KEY=<GENERATE_WITH_OPENSSL_RAND_HEX_32>
JWT_SECRET_KEY=<GENERATE_WITH_OPENSSL_RAND_HEX_32>
DATABASE_URL=postgresql+psycopg://<DB_USER>:<DB_PASSWORD>@localhost:5432/erp_db
# Origines autorisees (dev) : web :3000, desk/Electron :3001, super-admin :3002,
# Expo web de l'app mobile :8081 (http://localhost:8081 par defaut).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002,http://localhost:8081,http://127.0.0.1:8081
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=<GENERATE_WITH_OPENSSL_RAND_HEX_32>
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SERPAPI_KEY=
ENCRYPTION_KEY=<GENERATE_WITH_OPENSSL_RAND_HEX_32>
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@mihaja-erp.local
MAIL_FROM_NAME=MIHAJA ERP
MAIL_USE_TLS=true
MAIL_TIMEOUT=15
# Interrupteur SMTP : false par defaut (aucun envoi accidentel). Activer
# uniquement quand MAIL_HOST/MAIL_USERNAME/MAIL_PASSWORD sont renseignes.
MAIL_ENABLED=false
APP_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=30
# Mots de passe lus par web/backend/scripts/ (jamais en clair dans le code,
# P0 #70/A3) : renseigner une valeur forte hors versionnement, laisser vide ici.
DEFAULT_ADMIN_PASSWORD=
# Comptes de démonstration seed_mada_business.py (optionnel) :
SEED_MADA_PASSWORD=
# Comptes entreprise reset_enterprise_passwords.py (obligatoire) :
SEED_USER_PASSWORD=
UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH=16777216
PAPI_API_URL=https://app.papi.mg/dashboard/api/payment-links
PAPI_API_KEY=
PAPI_ENVIRONMENT=sandbox
PAPI_WEBHOOK_SECRET=<GENERATE_WITH_OPENSSL_RAND_HEX_32>
PAPI_CALLBACK_URL=http://localhost:5000/api/v1/papi/webhook

# ============================================================
# BACKEND LOCAL EMBARQUE (desktop 100% hors-ligne)
# ============================================================
# Ce bloc ne concerne QUE le poste de travail (Electron). Le serveur central
# reste en PostgreSQL : FLASK_ENV=production y refuse toujours SQLite.
#
# Utiliser ces valeurs pour lancer le backend embarque a la main :
#   FLASK_ENV=local-embedded LOCAL_DB_PATH=./erp-local.db \
#   REPLICATION_URL=https://erp.mihaja.mg python run.py
#
# FLASK_ENV=local-embedded
# LOCAL_DB_PATH=./erp-local.db
# REPLICATION_URL=https://erp.mihaja.mg
# REPLICATION_DEVICE_ID=<UUID_DU_POSTE>
# LOCAL_API_PORT=5000

# Entretien de la replication (valeurs par defaut entre parentheses) :
# - SYNC_OUTBOX_RETENTION_DAYS (30) : purge des mutations deja poussees.
# - SYNC_CLOCK_DRIFT_TOLERANCE_S (300) : ecart d'horloge poste/central tolere
#   avant alerte (les conflits sont arbitres par la date la plus recente).
# SYNC_OUTBOX_RETENTION_DAYS=30
# SYNC_CLOCK_DRIFT_TOLERANCE_S=300
