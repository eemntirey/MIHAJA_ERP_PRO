FLASK_ENV=development
SECRET_KEY=<GENERATE_WITH_OPENSSL_RAND_HEX_32>
JWT_SECRET_KEY=<GENERATE_WITH_OPENSSL_RAND_HEX_32>
DATABASE_URL=postgresql+psycopg://<DB_USER>:<DB_PASSWORD>@localhost:5432/erp_db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=<GENERATE_WITH_OPENSSL_RAND_HEX_32>
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SERPAPI_KEY=
ENCRYPTION_KEY=<GENERATE_WITH_OPENSSL_RAND_HEX_32>
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@mihaja-erp.local
MAIL_FROM_NAME=MIHAJA ERP
MAIL_USE_TLS=true
MAIL_TIMEOUT=15
# Interrupteur SMTP : false par defaut (aucun envoi accidentel). Activer
# uniquement quand MAIL_HOST/MAIL_USERNAME/MAIL_PASSWORD sont renseignes.
MAIL_ENABLED=false
APP_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=30
UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH=16777216
PAPI_API_URL=https://app.papi.mg/dashboard/api/payment-links
PAPI_API_KEY=
PAPI_ENVIRONMENT=sandbox
PAPI_WEBHOOK_SECRET=<GENERATE_WITH_OPENSSL_RAND_HEX_32>
PAPI_CALLBACK_URL=http://localhost:5000/api/v1/papi/webhook
