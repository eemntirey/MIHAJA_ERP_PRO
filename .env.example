# MIHAJA ERP PRO - Environnement local (exemple)
# Copier en .env et remplacer par des valeurs réelles (hors versionnement).
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=jwt-secret-key-change-in-production
DATABASE_URL=sqlite:///erp.db

# Mots de passe lus par web/backend/scripts/ (jamais en clair dans le code,
# P0 #70/A3) : renseigner une valeur forte hors versionnement, laisser vide ici.
DEFAULT_ADMIN_PASSWORD=
# Comptes de démonstration seed_mada_business.py (optionnel) :
SEED_MADA_PASSWORD=
# Comptes entreprise reset_enterprise_passwords.py (obligatoire) :
SEED_USER_PASSWORD=

# ============================================================
# BACKEND LOCAL EMBARQUE (desktop 100% hors-ligne)
# ============================================================
# Ces variables ne concernent que le backend embarque dans Electron. Elles
# sont normalement posees automatiquement par desk/electron/backendHost.js
# (base SQLite dans app.getPath('userData'), port dynamique).
#
# FLASK_ENV=local-embedded
# LOCAL_DB_PATH=./erp-local.db
# REPLICATION_URL=https://erp.mihaja.mg
# REPLICATION_DEVICE_ID=<UUID_DU_POSTE>
# LOCAL_API_PORT=5000
#
# Entretien de la replication (defauts : 30 jours / 300 secondes) :
# SYNC_OUTBOX_RETENTION_DAYS=30
# SYNC_CLOCK_DRIFT_TOLERANCE_S=300
