{
  "name": "mihaja_erp_pro",
  "version": "1.0.0",
  "description": "Application web de gestion commerciale multi-tenant avec marketplace publique, abonnements par entreprise et rôle Super Admin privé.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "install:web": "npm --prefix web/frontend ci",
    "install:desk": "npm --prefix desk ci",
    "install:admin": "npm --prefix super-admin ci",
    "install:all": "npm run install:web && npm run install:desk && npm run install:admin",
    "dev:web": "npm --prefix web/frontend start",
    "dev:desk": "npm --prefix desk run electron:dev",
    "dev:admin": "npm --prefix super-admin run dev",
    "build:web": "npm --prefix web/frontend run build",
    "build:desk": "npm --prefix desk run build",
    "build:admin": "npm --prefix super-admin run build",
    "build:all": "npm run build:web && npm run build:desk && npm run build:admin",
    "test:web": "npm --prefix web/frontend test -- --watchAll=false",
    "test:desk": "npm --prefix desk run test:startup",
    "test:backend": "python -m pytest web/backend/tests -x --tb=short -q",
    "test:e2e": "npx playwright test",
    "test:all": "npm run test:backend && npm run test:desk && npm run test:e2e",
    "audit:web": "npm --prefix web/frontend audit --audit-level=moderate",
    "audit:desk": "npm --prefix desk audit --audit-level=moderate",
    "audit:admin": "npm --prefix super-admin audit --audit-level=moderate",
    "audit:all": "npm run audit:web && npm run audit:desk && npm run audit:admin"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eemntirey/MIHAJA_ERP_PRO.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/eemntirey/MIHAJA_ERP_PRO/issues"
  },
  "homepage": "https://github.com/eemntirey/MIHAJA_ERP_PRO#readme",
  "dependencies": {
    "axios": "^1.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-toastify": "^11.1.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1"
  }
}
