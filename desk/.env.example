# Desk (Electron + Vite) — en dev, les appels passent par le PROXY Vite
# (same-origin) : /api, /public, /socket.io (ws) → http://127.0.0.1:5000
# (voir vite.config.js). La CSP de index.html (connect-src 'self') bloque
# toute URL absolue — ne PAS redéfinir VITE_API_URL/VITE_SOCKET_URL ici.
#
# Alternative (appels directs) : nécessiterait d'élargir connect-src
# dans desk/index.html ET CORS_ORIGINS côté backend — déconseillé.
# VITE_API_URL=http://localhost:5000/api/v1
# VITE_PUBLIC_API_URL=http://localhost:5000
# VITE_SOCKET_URL=http://localhost:5000
# VITE_WS_URL=http://localhost:5000
VITE_APP_NAME=TIA INFO WHOLESALE / ERP PRO
VITE_VERSION=1.0.0
