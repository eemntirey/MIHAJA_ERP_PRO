{
  "name": "erp-frontend-desk",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:startup": "node --test electron/startup.test.js",
    "electron": "node electron/run.js",
    "electron:dev": "concurrently -k -n WEB,ELECTRON \"vite\" \"wait-on http://localhost:3001 && node electron/run.js\"",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "release": "npm run build:backend && npm run test:startup && vite build && electron-builder",
    "build:backend": "powershell -ExecutionPolicy Bypass -File electron/backend/build_backend.ps1",
    "dist:offline": "npm run build && npm run build:backend && electron-builder"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@tanstack/react-virtual": "^3.14.10",
    "axios": "^1.19.0",
    "framer-motion": "^13.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.85.0",
    "react-router-dom": "^7.18.2",
    "react-toastify": "^11.1.0",
    "socket.io-client": "^4.7.5",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^38.8.6",
    "electron-builder": "^26.0.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.erppro.desk",
    "productName": "ERP Pro Desktop",
    "extraResources": [
      {
        "from": "electron/backend/dist",
        "to": "backend"
      }
    ],
    "files": [
      "build/**/*",
      "electron/**/*"
    ],
    "directories": {
      "buildResources": "public",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico",
      "artifactName": "MIHAJA-ERP-PRO-Setup.exe"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    }
  }
}
