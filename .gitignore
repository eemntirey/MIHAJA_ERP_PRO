.svelte-kit/

*.tmp
*.temp
*.swp
*.swo

~*
*.orig
*.rej


# ============================================================
# 9. TESTS / DEBUG / DIAGNOSTIC TEMPORAIRE
# ============================================================

# Préfixes explicitement temporaires
zz_*
tmp_*
temp_*

# Fichiers de debug
*_debug.py
*_debug.js
*_debug.jsx
*_debug.ts
*_debug.tsx

# Sorties de diagnostic
test_output.txt
debug_output.txt
diagnostic_output.txt

# Dumps / rapports temporaires
debug_dump.*
diagnostic_dump.*


