# ============================================================
# MIHAJA_ERP_PRO - .gitignore
# ============================================================
# Projet ERP multi-tenant
# Backend   : Flask / Python
# Frontend  : React
# Desktop   : Electron / React
# Super Admin : React
# ============================================================


# ============================================================
# 1. ENVIRONNEMENT / SECRETS
# ============================================================

# Fichiers d'environnement
.env
.env.*
!.env.example

# Variantes locales
.env.local
.env.development.local
.env.test.local
.env.production.local

# Backend
web/backend/.env
web/backend/.env.*
!web/backend/.env.example

# Frontend
web/frontend/.env
web/frontend/.env.*
!web/frontend/.env.example

# Desktop / Electron
desk/.env
desk/.env.*
!desk/.env.example

# Super Admin
super-admin/.env
super-admin/.env.*
!super-admin/.env.example

# Clés / certificats / secrets locaux
*.pem
*.key
*.crt
*.p12
*.pfx
*.secret
secrets/
secrets.json
credentials.json


