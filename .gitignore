device-id
device_id
deviceId.json


# ============================================================
# 24. FICHIERS SENSIBLES SUPPLÉMENTAIRES
# ============================================================

# Ne jamais versionner les fichiers contenant des secrets
passwords.txt
password.txt
credentials.txt
secrets.txt
private_key.txt

# Configurations locales sensibles
config.local.json
settings.local.json


# ============================================================
# 25. EXCEPTIONS : FICHIERS DE PROJET À CONSERVER
# ============================================================

# Exemples d'environnement
!**/.env.example

# Git keep files
!**/.gitkeep

# Documentation
!README.md
!**/README.md

# package manifests
!package.json
!**/package.json

!package-lock.json
!**/package-lock.json

# Docker
!docker-compose.yml
