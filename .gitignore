!web/backend/app/uploads/.gitkeep

# Documents générés
web/backend/app/generated/*
!web/backend/app/generated/.gitkeep

# Exports
web/backend/exports/*
!web/backend/exports/.gitkeep

# Rapports temporaires
web/backend/reports/*
!web/backend/reports/.gitkeep

# Fichiers PDF générés
*.pdf.tmp

# Fichiers Excel temporaires
*.xlsx.tmp
*.xls.tmp


