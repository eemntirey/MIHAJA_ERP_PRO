# Copier ce fichier en ".env" puis adapter l'URL.
# L'URL est inlinée dans le bundle JS au démarrage (variables EXPO_PUBLIC_*).

# Backend Flask de l'ERP — URL SANS slash final.
#
# - Émulateur Android :
#     http://10.0.2.2:5000/api/v1   (10.0.2.2 = localhost du PC hôte)
#
# - Appareil physique (téléphone) sur le même Wi-Fi que le PC :
#     http://<IP_DU_PC>:5000/api/v1
#     → Récupérer l'IP avec « ipconfig » (ligne Adresse IPv4, ex. 192.168.1.20)
#
# - Web (npx expo start --web) :
#     http://localhost:5000/api/v1
#
# Une URL « locale » (10.0.2.2 / localhost) est de toute façon adaptée à la
# plateforme d'exécution au démarrage (src/config/resolveApiUrl.js) : le web
# utilise l'hôte de la page (localhost:8081 → localhost) et l'émulateur Android
# 10.0.2.2. Une URL non locale (IP LAN, tunnel HTTPS, domaine de prod) est
# utilisée telle quelle — c'est elle qu'on renseigne pour un appareil physique.
#
# Port du backend forcé si nécessaire :
# EXPO_PUBLIC_API_PORT=5000
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api/v1
